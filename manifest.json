{
  "manifest_version": 3,
  "name": "PDV Mogo → iFood",
  "version": "0.1.0",
  "description": "Captura códigos da Mogo por ativação manual e prepara a vinculação com o iFood.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://portal.ifood.com.br/menu/list/pdv*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "PDV Mogo → iFood",
    "default_popup": "popup.html"
  }
}
